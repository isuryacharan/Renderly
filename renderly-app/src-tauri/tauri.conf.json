{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Renderly",
  "version": "0.1.0",
  "identifier": "dev.renderly.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run fetch-ffmpeg && npm run build:wasm && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Renderly",
        "width": 1600,
        "height": 950,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/media-cache/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "ffmpeg/*",
      "../../THIRD-PARTY-NOTICES.md",
      "../../NOTICE-ffmpeg.md",
      "../../LICENSE"
    ],
    "publisher": "Renderly",
    "copyright": "Copyright © 2026 Renderly contributors. AGPL-3.0.",
    "category": "Video",
    "homepage": "https://github.com/isuryacharan/Renderly",
    "shortDescription": "AI-native, open-source video editor.",
    "longDescription": "An open-source, native video editor built for AI agents — and the humans who finish the job. One command API drives the GUI, the CLI, and MCP.",
    "license": "AGPL-3.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
