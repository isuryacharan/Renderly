{
  "name": "renderly",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @renderly/spike dev",
    "dev:editor": "pnpm --filter @renderly/editor dev",
    "build": "pnpm -r --if-present build",
    "preview": "pnpm --filter @renderly/spike preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:tokens": "pnpm --filter @renderly/ui check:tokens",
    "bench": "node scripts/bench.mjs",
    "test:storage": "node scripts/storage-e2e.mjs",
    "test:editor": "node scripts/editor-e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
